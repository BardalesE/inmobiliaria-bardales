# ──────────────────────────────────────────────────────────
#  EE-Stars Frontend — Variables de entorno
#  Copia este archivo a .env.local y rellena los valores.
#  Las variables NEXT_PUBLIC_* son visibles en el navegador.
# ──────────────────────────────────────────────────────────

# URL base de la API del backend
# En desarrollo:   http://localhost:4000/api
# En producción:   https://tudominio.com/api   (mismo dominio con Nginx proxy)
#                  https://api.tudominio.com/api (subdominio separado)
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# Número de WhatsApp para botones de contacto (con código de país, sin +)
NEXT_PUBLIC_WHATSAPP=51982946582

# URL pública del sitio (para metadataBase / Open Graph)
# En desarrollo:   http://localhost:3000
# En producción:   https://tudominio.vercel.app o el dominio propio
NEXT_PUBLIC_SITE_URL=http://localhost:3000
