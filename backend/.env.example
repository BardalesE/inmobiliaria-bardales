# ──────────────────────────────────────────
#  EE-Stars Backend — Variables de entorno
#  Copia este archivo a .env y rellena los valores reales.
#  NUNCA subas el .env real a git.
# ──────────────────────────────────────────

# ── Base de datos ──────────────────────────
# Formato: mysql://USUARIO:CONTRASEÑA@HOST:PUERTO/NOMBRE_DB
# Ejemplo local (Laragon): mysql://root:@localhost:3306/eestars
#
# Producción (Aiven MySQL): Prisma NO entiende `?ssl-mode=REQUIRED` de la URI
# que da Aiven. Usa en su lugar `?sslaccept=strict&sslcert=aiven-ca.pem`
# (el certificado CA del proyecto está versionado en prisma/aiven-ca.pem y la
# ruta de sslcert se resuelve relativa a la carpeta prisma/):
# DATABASE_URL="mysql://USUARIO:CLAVE@SERVICIO.aivencloud.com:PUERTO/defaultdb?sslaccept=strict&sslcert=aiven-ca.pem"
DATABASE_URL="mysql://root:@localhost:3306/eestars"

# ── Servidor ───────────────────────────────
PORT=4000
# "development" en local, "production" en VPS
NODE_ENV=development

# ── Frontend (para CORS) ───────────────────
# En desarrollo:   http://localhost:3000
# En producción:   el dominio de Vercel (ej. https://ee-stars.vercel.app)
FRONTEND_URL=http://localhost:3000

# ── Configuración de cookies ───────────────
# Arquitectura de producción: frontend en Vercel + API en Railway (dominios distintos)
#   → en Railway usa SAME_DOMAIN=false (cookie sameSite=none + secure, ambos tienen HTTPS)
# En desarrollo local (localhost:3000 ↔ localhost:4000) déjalo en true.
SAME_DOMAIN=true

# ── Usuarios del panel ─────────────────────
# El login usa la tabla `users` de la base de datos (email + contraseña).
# - Crear el admin inicial:  npm run db:seed  (admin@ee-stars.pe)
# - Crear más usuarios:      npm run user:create  (roles ADMIN o AGENT)
# Opcional: hash bcrypt para la clave del admin del seed (si no, usa la de desarrollo)
# Genera uno con: node -e "console.log(require('bcryptjs').hashSync('TU_CLAVE', 12))"
# ADMIN_PASSWORD_HASH=

# ── JWT ────────────────────────────────────
# Genera un secret seguro con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=cambia_esto_por_un_string_largo_y_aleatorio
JWT_EXPIRES_IN=8h

# ── Notificaciones por email (Gmail) ───────
# Activa "Contraseñas de aplicación" en tu cuenta Google:
# Cuenta → Seguridad → Verificación en 2 pasos → Contraseñas de app
NOTIFY_EMAIL_FROM=tu_correo@gmail.com
NOTIFY_EMAIL_PASS=xxxx xxxx xxxx xxxx
NOTIFY_EMAIL_TO=correo_de_notificaciones@gmail.com

# ── WhatsApp ───────────────────────────────
# Número con código de país, sin + ni espacios
WHATSAPP_NUMBER=51987654321

# ── Cloudinary ─────────────────────────────
# Obtén estas credenciales en: cloudinary.com → Settings → API Keys
CLOUDINARY_CLOUD_NAME=tu_cloud_name
CLOUDINARY_API_KEY=tu_api_key
CLOUDINARY_API_SECRET=tu_api_secret
